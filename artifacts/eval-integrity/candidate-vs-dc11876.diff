+        base2hVnds: Set<number>;
+        overnightVnds: Set<number>;
+        dayNightVnds: Set<number>;
+        extraHourRateVnds: Set<number>;
+        hourlyExtendedVnds: Set<number>;
+      }
+    >();
+    const amounts = new Set<number>();
+    const roomIds: string[] = [];
+
+    for (const c of allCands) {
