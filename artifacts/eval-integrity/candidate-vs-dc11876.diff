+  private validateStructuredClaimRefs(
+    text: string,
+    context: ClaimValidationContext,
+    recordCheck: (c: DetailedClaimCheck) => void
+  ): void {
+    const refs = context.structuredClaimRefs;
+    if (!refs || refs.length === 0) return;
+    const evidenceMap = new Map<string, BusinessEvidenceRecord>();
+    for (const ev of context.validEvidence || []) {
+      evidenceMap.set(ev.evidenceId, ev);
+    }
+    const textPrices = new Set(extractVndMentions(text).map((m) => m.amountVnd));
+
+    for (const refId of refs) {
+      const ev = evidenceMap.get(refId);
+      if (!ev || !ev.isValid) {
+        recordCheck({
+          claim_type: 'POLICY',
+          raw_text: refId,
+          status: 'CONTRADICTED',
+          reason: `REJECTED_INVALID_CLAIM_REF: Structured claim_ref "${refId}" is missing or invalidated.`,
+        });
+        continue;
+      }
+      if (ev.evidenceType === 'QUOTE' && typeof ev.amountVnd === 'number' && textPrices.size > 0) {
+        const expectedSet = new Set<number>([ev.amountVnd, ...(ev.alternateAmountsVnd || [])]);
+        const hasAnyExpected = Array.from(textPrices).some((p) => expectedSet.has(p));
+        if (!hasAnyExpected) {
+          recordCheck({
+            claim_type: 'PRICE',
+            raw_text: refId,
+            normalized_value: ev.amountVnd,
+            status: 'CONTRADICTED',
+            reason: `REJECTED_CLAIM_REF_TEXT_MISMATCH: Structured claim_ref "${refId}" expects ${ev.amountVnd.toLocaleString('vi-VN')}đ, which mismatches final text prices [${Array.from(textPrices).join(', ')}].`,
+          });
+        }
+      }
+    }
+  }
