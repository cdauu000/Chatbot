+      const bp = c.base_pricing;
+      if (!bp) continue;
+      if (typeof bp.nghi_gio_2h === 'number') amounts.add(bp.nghi_gio_2h);
+      if (typeof bp.qua_dem === 'number') amounts.add(bp.qua_dem);
+      if (typeof bp.ngay_dem === 'number') amounts.add(bp.ngay_dem);
