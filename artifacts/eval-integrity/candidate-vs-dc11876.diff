+import { createHash } from 'node:crypto';
+import { NormalizedDataset } from '../../domain/normalized-schema.js';
+import { CoSoMa, StayType } from '../../domain/types.js';
+import {
+  AgentState,
+  BusinessEvidenceRecord,
+  RoomPresentationBlock,
