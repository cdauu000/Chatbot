# ============================================================================
# J COLLECTION AI CONCIERGE — ENVIRONMENT CONFIGURATION (MILESTONE 3.5)
# FREE MULTI-PROVIDER LLM CONFIGURATION (GROQ + GEMINI · STRICT FREE-ONLY MODE)
# ============================================================================

# Conversation Engine: legacy | agentic
CONVERSATION_ENGINE=agentic

# Enforce strict Free-Only mode (never allow fallback or escalation to paid APIs)
FREE_ONLY_MODE=true

# Routing mode: auto | groq | gemini | mock
# auto: attempts Groq Free -> Gemini Free -> Mock Deterministic fallback
LLM_PROVIDER=auto

# ----------------------------------------------------------------------------
# Provider A: Groq Free Tier
# Sign up and obtain free key: https://console.groq.com/keys
# Candidate models: openai/gpt-oss-20b | llama-3.3-70b-versatile | llama-3.1-8b-instant
# ----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ----------------------------------------------------------------------------
# Provider B: Google Gemini Free Tier
# Sign up and obtain free key: https://aistudio.google.com/app/apikey
# Free models: gemini-3.5-flash-lite | gemini-3.8-flash (gemini-1.5/2.0 have been retired)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# ----------------------------------------------------------------------------
# Runtime Timeouts & Token Quotas
# ----------------------------------------------------------------------------
LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=600
LLM_FALLBACK_MODE=deterministic
